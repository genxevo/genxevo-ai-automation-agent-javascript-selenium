{
  "name": "@genxevo/genxevo-selenium-agent",
  "version": "0.1.0-alpha.1",
  "description": "MCP server that gives an AI coding agent deterministic, evidence-first capabilities for engineering JavaScript + Selenium UI automation projects.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "selenium",
    "selenium-webdriver",
    "test-automation",
    "qa",
    "ai-agent",
    "genxevo"
  ],
  "homepage": "https://genxevo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenXEvo/genxevo-ai-automation-agent-javascript-selenium.git"
  },
  "bugs": {
    "url": "https://github.com/GenXEvo/genxevo-ai-automation-agent-javascript-selenium/issues"
  },
  "license": "MIT",
  "author": "Rajeshkumar Muthu",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "genxevo-selenium-agent": "src/mcp/main.js"
  },
  "exports": {
    ".": "./src/mcp/main.js"
  },
  "files": [
    "src/",
    "docs/",
    "prompts/",
    "examples/",
    "genxevo.config.example.json",
    ".mcp.json.example",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:unit": "node --test \"test/!(mcp).test.js\"",
    "test:mcp": "node --test test/mcp.test.js",
    "coverage": "c8 --check-coverage node --test \"test/*.test.js\"",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run format:check && npm run coverage && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "c8": "12.0.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6"
  }
}
